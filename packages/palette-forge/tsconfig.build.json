{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    // No declaration maps: `src/` is not published, so they would point at
    // files that don't exist in the tarball and break "go to definition".
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["test", "**/*.test.ts"]
}
